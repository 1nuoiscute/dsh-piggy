{
  "name": "dsh-piggy-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "dsh-piggy 桌面版：DSH 之外，双击就有一只猪",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "pack-game": "node scripts/pack-game.mjs",
    "start": "npm run pack-game && electron .",
    "dist:linux": "npm run pack-game && electron-builder --linux",
    "dist:win": "npm run pack-game && electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.clicgger.dshpiggy",
    "productName": "dsh-piggy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CLICGGER-TYPES",
        "repo": "dsh-piggy"
      }
    ]
  },
  "allowScripts": {
    "electron@44.5.1": true
  }
}
